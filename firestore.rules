rules_version = '2';

// Security rules for Emi's Learning Platform online friends.
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
//
// - Each player can only create, change or delete THEIR OWN profile.
// - Profiles can only hold the few fields the game uses (nickname, emoji, points, league,
//   streak, challenge score), with sensible sizes, so nothing else can be stored.
// - Signed-in players can read profiles (to show friends) and search at most 10 at a time.

service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 10;
      allow create, update: if request.auth != null && request.auth.uid == uid && validPlayer(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function isDayOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'nameLower', 'nameKey', 'tag', 'emoji', 'bg', 'points', 'rank', 'rankAvg',
                               'streak', 'streakDay', 'chDay', 'chScore', 'chTime', 'updated'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.nameLower == d.name.lower()
        && (!('nameKey' in d) || (d.nameKey is string && d.nameKey.size() <= 20))
        && d.tag is string && d.tag.size() <= 4
        && d.emoji is string && d.emoji.size() <= 16
        && d.bg is string && d.bg.size() <= 30
        && d.points is int && d.points >= 0 && d.points <= 10000000
        && (d.rank == null || d.rank in ['bronze', 'silver', 'gold', 'diamond', 'amethyst'])
        && (d.rankAvg == null || (d.rankAvg is number && d.rankAvg >= 0 && d.rankAvg <= 10))
        && d.streak is int && d.streak >= 0 && d.streak <= 3650
        && isDayOrNull(d.streakDay) && isDayOrNull(d.chDay)
        && d.chScore is int && d.chScore >= 0 && d.chScore <= 10
        && d.chTime is number && d.chTime >= 0 && d.chTime <= 9999
        && d.updated is timestamp;
    }
  }
}
